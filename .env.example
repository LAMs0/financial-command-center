# ── Financial Command Center — variables de entorno ─────────────────────────
# Copia este archivo a `.env` y rellena los valores reales.
# NUNCA comitees `.env` (ya está en .gitignore).

# Fuente de datos: "database" (Prisma/PostgreSQL) o "mock" (datos locales).
DATA_SOURCE="database"

# PostgreSQL. En local/Neon usa tu connection string con sslmode=require.
# En Railway puedes usar el Postgres del proyecto (variable inyectada) o tu Neon.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js (NextAuth v5)
# Genera el secret con:  npx auth secret
AUTH_SECRET="genera-uno-con-npx-auth-secret"

# Credenciales OAuth de Google Cloud Console (APIs & Services → Credentials).
AUTH_GOOGLE_ID="xxxxxxxx.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="GOCSPX-xxxxxxxx"

# Opcional: fuerza la URL pública en producción si trustHost no la detecta.
# AUTH_URL="https://tu-dominio.com"
