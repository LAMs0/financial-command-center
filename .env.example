# ── Financial Command Center — variables de entorno ─────────────────────────
# Copia este archivo a `.env` y rellena los valores reales.
# NUNCA comitees `.env` (ya está en .gitignore).

# Fuente de datos: "database" (Prisma/PostgreSQL) o "mock" (datos locales).
DATA_SOURCE="database"

# PostgreSQL. En local/Neon usa tu connection string con sslmode=require.
# En Railway puedes usar el Postgres del proyecto (variable inyectada) o tu Neon.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js (NextAuth v5)
# Genera el secret con:  npx auth secret
AUTH_SECRET="genera-uno-con-npx-auth-secret"

# Credenciales OAuth de Google Cloud Console (APIs & Services → Credentials).
AUTH_GOOGLE_ID="xxxxxxxx.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="GOCSPX-xxxxxxxx"

# Opcional: fuerza la URL pública en producción si trustHost no la detecta.
# AUTH_URL="https://tu-dominio.com"

# ── Conectividad bancaria ───────────────────────────────────────────────────
# Proveedor del agregador: "mock" (gratis, default) o "plaid" (requiere keys).
BANK_PROVIDER="mock"
# Plaid (solo si BANK_PROVIDER="plaid"). El entorno Sandbox es gratis.
# PLAID_CLIENT_ID=""
# PLAID_SECRET=""
# PLAID_ENV="sandbox"   # sandbox | development | production

# ── Cifrado de datos sensibles ──────────────────────────────────────────────
# Clave de 32 bytes en hex (64 chars) para AES-256-GCM. Genera con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Necesaria para cifrar access_tokens de Plaid (modelo BankConnection).
# APP_ENCRYPTION_KEY=""

# ── Rate limiting distribuido (producción multi-instancia) ──────────────────
# Si se definen, el rate-limit usa Upstash Redis (compartido entre instancias).
# Si se omiten, cae a un limitador en memoria (ok para instancia única/dev).
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
